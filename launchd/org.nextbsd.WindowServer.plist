<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (c) 2026, Joseph Maloney
  SPDX-License-Identifier: BSD-2-Clause

  WindowServer LaunchDaemon. It ships Disabled, so launchd doesn't start
  it at boot and take the console from getty or Xorg. Booting to the
  graphical login enables it with "launchctl load -w" (pkgdemon/
  nextbsd-gnustep enable-loginwindow.sh); "launchctl unload -w" disables
  it again. Once loaded it starts at once and KeepAlive restarts it if it
  exits. The server starts as root, opens the display, VT and input
  devices, and then drops to _windowserver.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.nextbsd.WindowServer</string>
	<key>ProgramArguments</key>
	<array>
		<string>/System/Library/CoreServices/WindowServer</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>org.nextbsd.windowserver</key>
		<true/>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>Disabled</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/WindowServer.log</string>
</dict>
</plist>
