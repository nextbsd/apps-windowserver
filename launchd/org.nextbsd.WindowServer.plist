<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (c) 2026, Joseph Maloney
  SPDX-License-Identifier: BSD-2-Clause

  WindowServer LaunchDaemon. Proof of concept: it ships Disabled, so
  launchd doesn't start it at boot and take the console from getty or
  Xorg. To try it: launchctl load -F /System/Library/LaunchDaemons/org.nextbsd.WindowServer.plist
  KeepAlive starts it as soon as it is loaded and restarts it if it
  exits. The server starts as root, opens the display, VT and input
  devices, and then drops to _windowserver.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.nextbsd.WindowServer</string>
	<key>ProgramArguments</key>
	<array>
		<string>/System/Library/CoreServices/WindowServer</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>org.nextbsd.windowserver</key>
		<true/>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<false/>
	<key>Disabled</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/WindowServer.log</string>
</dict>
</plist>
