<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (c) 2026, Joseph Maloney
  SPDX-License-Identifier: BSD-2-Clause

  WindowServer defaults. Every key can also be set from the environment
  as WS_<Key>, e.g. WS_KeyboardLayout=de. These are the built-in values.
-->
<plist version="1.0">
<dict>
	<key>KeyboardRules</key>
	<string>evdev</string>
	<key>KeyboardModel</key>
	<string>pc105</string>
	<key>KeyboardLayout</key>
	<string>us</string>
	<key>KeyboardVariant</key>
	<string></string>
	<key>KeyboardOptions</key>
	<string></string>
	<!-- milliseconds before the first repeat, and between repeats -->
	<key>KeyRepeatDelay</key>
	<integer>500</integer>
	<key>KeyRepeatInterval</key>
	<integer>33</integer>
	<!-- a click that activates an app is also delivered to it -->
	<key>ClickThrough</key>
	<true/>
	<key>RaiseOnClick</key>
	<true/>
	<!-- skip kbdmux0 and sysmouse; only useful with per-device keyboards -->
	<key>IgnoreMuxDevices</key>
	<false/>
	<!-- Touchpad. Tapping clicks (one finger left, two right); tap,
	     then drag; SecondaryClick: TwoFingers, BottomRightCorner or
	     Off. ThreeFingerDrag moves three-finger swipes to four
	     fingers. Momentum scrolling carries on after the fingers
	     lift. PointerSpeed is -1 to 1 (every pointing device);
	     ScrollSpeed multiplies scroll distances. -->
	<key>TapToClick</key>
	<true/>
	<key>TapToDrag</key>
	<true/>
	<key>SecondaryClick</key>
	<string>TwoFingers</string>
	<key>ThreeFingerDrag</key>
	<false/>
	<key>MomentumScrolling</key>
	<true/>
	<key>NaturalScrolling</key>
	<false/>
	<key>PointerSpeed</key>
	<real>0</real>
	<key>ScrollSpeed</key>
	<real>1</real>
	<!-- Ctrl+Alt+Backspace stops the server (development) -->
	<key>AllowTerminate</key>
	<true/>
	<key>HardwareCursor</key>
	<true/>
	<key>BackgroundColor</key>
	<string>000000</string>
	<!-- Minimized windows become tiles along the bottom of the screen:
	     a live picture of the window with the app's icon in a corner.
	     MinimizeTileSize is in pixels (32 to 256; 64 lines tiles up
	     with GNUstep app icons). MinimizeTileImage is drawn behind the
	     picture instead of the plain dark rounded tile: an 8-bit binary
	     PAM (RGB_ALPHA or RGB) or PPM file, scaled to the tile. -->
	<key>MinimizeTileSize</key>
	<integer>64</integer>
	<key>MinimizeTileImage</key>
	<string></string>
	<!-- "Minimize into the Dock": while the Dock is connected, it shows
	     minimized windows (live previews from WindowServer) and
	     WindowServer draws no tiles. Off for now. -->
	<key>MinimizeIntoDock</key>
	<false/>
	<!-- empty: the first /dev/dri/card* with a connected display -->
	<key>DRMDevice</key>
	<string></string>
	<key>User</key>
	<string>_windowserver</string>
	<key>Group</key>
	<string>video</string>
</dict>
</plist>
