<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (c) 2026, Joseph Maloney
  SPDX-License-Identifier: BSD-2-Clause

  WindowServer defaults. Every key can also be set from the environment
  as WS_<Key>, e.g. WS_KeyboardLayout=de. These are the built-in values.
  The console user's own org.nextbsd.WindowServer defaults go on top of
  them while their session runs (README, "Settings"). SIGHUP makes the
  server read this file again.
-->
<plist version="1.0">
<dict>
	<key>KeyboardRules</key>
	<string>evdev</string>
	<key>KeyboardModel</key>
	<string>pc105</string>
	<!-- up to four layouts, e.g. us,gr, with variants to match -->
	<key>KeyboardLayout</key>
	<string>us</string>
	<key>KeyboardVariant</key>
	<string></string>
	<key>KeyboardOptions</key>
	<string></string>
	<!-- the keys that switch layouts: None, ControlSpace, AltShift,
	     WinSpace or CapsLock -->
	<key>KeyboardLayoutShortcut</key>
	<string>None</string>
	<!-- milliseconds before the first repeat, and between repeats -->
	<key>KeyRepeatDelay</key>
	<integer>500</integer>
	<key>KeyRepeatInterval</key>
	<integer>33</integer>
	<!-- a click that activates an app is also delivered to it -->
	<key>ClickThrough</key>
	<true/>
	<key>RaiseOnClick</key>
	<true/>
	<!-- skip kbdmux0 and sysmouse; only useful with per-device keyboards -->
	<key>IgnoreMuxDevices</key>
	<false/>
	<!-- Touchpad. Tapping clicks (one finger left, two right); tap,
	     then drag; SecondaryClick: TwoFingers, BottomRightCorner or
	     Off. ThreeFingerDrag moves three-finger swipes to four
	     fingers. Momentum scrolling carries on after the fingers
	     lift. PointerSpeed is -1 to 1 (every pointing device);
	     ScrollSpeed multiplies scroll distances. -->
	<key>TapToClick</key>
	<true/>
	<key>TapToDrag</key>
	<true/>
	<key>SecondaryClick</key>
	<string>TwoFingers</string>
	<key>ThreeFingerDrag</key>
	<false/>
	<key>MomentumScrolling</key>
	<true/>
	<key>NaturalScrolling</key>
	<false/>
	<key>PointerSpeed</key>
	<real>0</real>
	<!-- touchpads' and mice's own speeds; empty: PointerSpeed -->
	<key>TrackpadSpeed</key>
	<string></string>
	<key>MouseSpeed</key>
	<string></string>
	<!-- mouse acceleration: adaptive (on) or flat (off) -->
	<key>MouseAccelProfile</key>
	<string>adaptive</string>
	<!-- swap the primary and secondary buttons -->
	<key>LeftHanded</key>
	<false/>
	<key>ScrollSpeed</key>
	<real>1</real>
	<!-- Ctrl+Alt+Backspace stops the server (development) -->
	<key>AllowTerminate</key>
	<true/>
	<key>HardwareCursor</key>
	<true/>
	<key>BackgroundColor</key>
	<string>000000</string>
	<!-- Minimized windows become tiles along the bottom of the screen:
	     a live picture of the window with the app's icon in a corner.
	     MinimizeTileSize is in pixels (32 to 256; 64 lines tiles up
	     with GNUstep app icons). MinimizeTileImage is drawn behind the
	     picture instead of the plain dark rounded tile: an 8-bit binary
	     PAM (RGB_ALPHA or RGB) or PPM file, scaled to the tile. -->
	<key>MinimizeTileSize</key>
	<integer>64</integer>
	<key>MinimizeTileImage</key>
	<string></string>
	<!-- "Minimize into the Dock" for apps that don't say where a
	     window goes: while the Dock is connected, it shows them (live
	     previews from WindowServer) and WindowServer draws no tiles.
	     GNUstep apps say, from the user's NBMinimizeStyle. Off. -->
	<key>MinimizeIntoDock</key>
	<false/>
	<!-- The window overview (Exposé): a tap of the Start key on its
	     own opens and closes it. Control+Up, Control+Down, the Mission
	     Control key and three-finger swipes always work. -->
	<key>StartKeyShowsOverview</key>
	<true/>
	<!-- No animations (the overview's). -->
	<key>ReduceMotion</key>
	<false/>
	<!-- Window tiling (README, "Window tiling"): "stacking" or
	     "tiling". Workspace Preferences sets the user's choice. -->
	<key>WindowMode</key>
	<string>stacking</string>
	<!-- "dwindle" (each window splits what is left) or "master" (one
	     window beside a stack of the others) -->
	<key>TilingLayout</key>
	<string>dwindle</string>
	<!-- pixels between tiles (0 to 64) and around them (0 to 128) -->
	<key>TilingGapsInner</key>
	<integer>8</integer>
	<key>TilingGapsOuter</key>
	<integer>8</integer>
	<!-- the master window's share of the screen, 0.1 to 0.9 -->
	<key>TilingMasterRatio</key>
	<real>0.55</real>
	<!-- a border round the key window while it is tiled: pixels (0 for
	     none, up to 16) and colour -->
	<key>TilingBorder</key>
	<integer>2</integer>
	<key>TilingBorderColor</key>
	<string>4a7fc0</string>
	<!-- the modifier of the tiling keys: Command, Option, Control or a
	     combination ("Command+Option"); never Shift -->
	<key>TilingModifier</key>
	<string>Command+Option</string>
	<!-- the tile a new window splits (dwindle), along its longer side:
	     "largest" (the largest tile, the leftmost then topmost of equal
	     ones: windows fill the screen evenly), "pointer" (the tile under
	     the pointer, else the focused one, as on Hyprland) or "focused" -->
	<key>TilingNewWindowSplits</key>
	<string>largest</string>
	<!-- while tiling, the tile under the pointer has the focus: moving
	     the pointer onto a tiled window makes it key and its app active
	     (not while a button is held, a drag or a menu lasts, nor over
	     the Dock or a window that floats) -->
	<key>TilingFocusFollowsMouse</key>
	<true/>
	<!-- empty: the first /dev/dri/card* with a connected display -->
	<key>DRMDevice</key>
	<string></string>
	<key>User</key>
	<string>_windowserver</string>
	<key>Group</key>
	<string>video</string>
</dict>
</plist>
